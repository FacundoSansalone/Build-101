# Copiá este archivo a .env en la raíz del repo y completá lo que uses.
# `bash deploy/start_all.sh` y `bash world/run_world.sh` lo cargan solos; para
# levantar el proxy a mano: `set -a; source .env; set +a`.

# --- Modelos -----------------------------------------------------------------
# Clave de Google AI Studio (agentes de world/ y agente de intención):
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# O usar Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=tu-proyecto
# GOOGLE_CLOUD_LOCATION=global

# Juicios tipados del filtro y del intake (decisiones/): OpenAI Decisions o Jev.
# Sin ninguna de las dos, el intake usa Gemini y el filtro necesita
# FILTRO_SOLO_HEURISTICAS=1 (sin cliente, bloquea todo).
OPENAI_API_KEY=
# TYPESAFE_API_KEY=
# DECISIONES_PROVEEDOR=openai        # openai | jev (sin la variable: el que tenga clave)

# --- Capas de KaiAI ----------------------------------------------------------
# GUARD_FILTRO=filtro:filtrar        # start_all.sh lo pone solo
# FILTRO_SOLO_HEURISTICAS=1          # demo: con el modelo, el filtro corta el OTP honesto (DEMO.md)
# INTENCION_ACTIVA=1                 # 0 en el benchmark y smoke_checkout (no hay humano)
# INTENCION_PROVEEDOR=decisiones     # decisiones | gemini
# INTENCION_MODELO=gemini-3.1-flash-lite-preview
# FABRICANTE_FUENTE=fixture          # fixture (datos de prueba) | icecat | ninguna

# --- Demo ----------------------------------------------------------------------
# DEMO_PAUSA_AUTO_S=8                # plan gratuito de Gemini (0 si es pago)
# Por defecto manda la ficha que confirmó el usuario y las fechas son las de hoy.
# Solo para reproducir una grabación de un escenario fijo (fechas fijas, su ficha):
# DEMO_HOY=2026-10-18                # sin fijar: hoy de verdad
# PROXY_FICHA_DEMO=1                 # 0 (default): manda la ficha del usuario; 1: la del escenario fijo

# --- Registro de la demo en Supabase (opcional) --------------------------------
# Sin estas dos, no se registra nada.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# --- Gateway de producción (opcional; ver docs/INTEGRACION.md) ------------------
# GATEWAY_CLAVES_ARCHIVO=.temp-db/gateway_claves.json
# GATEWAY_COMERCIOS_ARCHIVO=
# GATEWAY_PORT=8030
# GATEWAY_PUBLIC_URL=http://localhost:8030
# GATEWAY_ESTADO=memoria             # memoria | supabase (migración proxy/sql/003_gateway.sql)

# --- Deploy público del panel (deploy/tenki.sh) ---------------------------------
# DASHBOARD_PUBLIC_ORIGINS=https://tu-dominio
# DASHBOARD_EXTRA_HOSTS=
# Publicado, el panel pide esta contraseña (HTTP Basic, 16+ caracteres); sin
# ella no arranca. tenki.sh genera una si falta.
# DASHBOARD_ACCESS_TOKEN=
