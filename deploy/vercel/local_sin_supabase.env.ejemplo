# Prueba local con varias instancias SIN Supabase: las instancias de
# local_multi.py comparten el PostgREST falso de postgrest_local.py
# (http://127.0.0.1:54321, las tablas gw_* en memoria).
#
# Copialo a .temp-db/vercel-local/local.env (ignorado por git) y pasalo
# DESPUÉS del vercel.env que arma generar_secretos.py (el último gana):
#
#   $PY deploy/vercel/postgrest_local.py                      # en otra terminal
#   $PY deploy/vercel/local_multi.py --instancias 2 \
#       --env .temp-db/vercel-local/vercel.env --env .temp-db/vercel-local/local.env
#
# Sin secretos: la clave de Supabase no se valida (cualquier texto) y la
# clave del recibo y la del integrador salen de vercel.env. ESTE ARCHIVO ESTÁ
# EN GIT: nunca pongas valores reales acá.

# http contra loopback: solo vale en la prueba local (en Vercel, https).
GATEWAY_PUBLIC_URL=http://127.0.0.1:8040

# El comercio de la simulación (bash world/run_world.sh general) por loopback.
GATEWAY_COMERCIOS_JSON={"por_defecto":"merchant_1","comercios":[{"id":"merchant_1","nombre":"Simulación","a2a_url":"http://127.0.0.1:8001/a2a/merchant_agent","catalogo_url":"http://127.0.0.1:8011","merchant_ids":["merchant_1"]}]}

# El PostgREST falso de postgrest_local.py (http solo contra loopback).
GATEWAY_ESTADO=supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-sin-supabase

# Filtro sin modelo (sin OPENAI_API_KEY ni TYPESAFE_API_KEY bloquearía todo).
GUARD_FILTRO=filtro:filtrar
FILTRO_SOLO_HEURISTICAS=1

# Sin credenciales del LLM la intención queda apagada y las compras siguen el
# pedido literal. Para probar las pausas (smoke_v1_pausas.py), poné tu
# GOOGLE_API_KEY (y OPENAI_API_KEY o TYPESAFE_API_KEY para el intake).
# GOOGLE_API_KEY=

FABRICANTE_FUENTE=fixture
