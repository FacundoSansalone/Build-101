# Entorno del motor de KaiAI en Vercel (solo el motor: la simulación corre en
# tu máquina detrás del túnel).
#
# - Para Vercel: cargá cada variable con
#     npx vercel env add NOMBRE production < archivo_con_el_valor
#   (los secretos los genera deploy/vercel/generar_secretos.py, uno por archivo).
# - Para la prueba local: copiá este archivo a .temp-db/vercel/local.env
#   (ignorado por git), completalo y pasalo con `local_multi.py --env`.
#
# Un valor vacío es "sin definir". ESTE ARCHIVO ESTÁ EN GIT: nunca pongas
# valores reales acá. Las PROHIBIDAS (abajo) hacen que el motor no arranque.

# ---------------------------------------------------------------------------
# Obligatorias (sin ellas la app responde 503 motor_no_configurado a todo)
# ---------------------------------------------------------------------------

# URL pública del deploy: Agent Card, a2a_url de las compras y OpenAPI. https
# en Vercel (el dominio de producción del proyecto, sin barra final). En la
# prueba local con local_multi.py: http://127.0.0.1:8040
GATEWAY_PUBLIC_URL=https://<tu-proyecto>.vercel.app

# Integradores y sus claves (solo el sha256), JSON en una línea. Lo arma
# generar_secretos.py → .temp-db/vercel/GATEWAY_CLAVES_JSON.json. Formato en
# proxy/README.md ("Integradores"). Al menos una clave activa. Una clave de
# solo lectura (el panel) lleva "permisos": ["lectura"]: generar_secretos.py
# --clave-lectura <id> la suma a este JSON.
GATEWAY_CLAVES_JSON=

# Comercios: JSON en una línea, formato en deploy/vercel/comercios.ejemplo.json
# (generar_secretos.py --dominio lo arma para el túnel). Fuera de loopback las
# URLs tienen que ser https.
GATEWAY_COMERCIOS_JSON=

# El estado vive en Supabase (varias instancias sin estado compartido).
# Migraciones proxy/sql/003_gateway.sql y 004_serverless.sql aplicadas a mano.
GATEWAY_ESTADO=supabase
SUPABASE_URL=https://<ref>.supabase.co
# Clave de servicio (service_role, o una sb_secret_…). Nunca la anon/publishable.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=   (el mismo dato con el otro nombre; con una alcanza)

# Clave del recibo: el PEM en base64 en una línea, la MISMA para todas las
# instancias (generar_secretos.py → GUARD_SIGNING_KEY_PEM_B64.txt). En Vercel
# nunca se crea una clave en disco.
GUARD_SIGNING_KEY_PEM_B64=
# GUARD_SIGNING_KEY_PEM=   (alternativa: el PEM en claro, con saltos de línea)

# El filtro de seguridad es obligatorio con el gateway.
GUARD_FILTRO=filtro:filtrar

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------

# kid de la clave del recibo (el de /v1/public-key).
GUARD_SIGNING_KID=guard-key-1

# El "hoy" del agente de intención ("el lunes", "mañana"): Vercel corre en
# UTC. Por defecto America/Argentina/Buenos_Aires (sin tzdata, UTC-3 fijo).
KAIAI_ZONA_HORARIA=

# Tiempos para Hobby (300 s por pedido, vercel.json → maxDuration). Sin la
# variable, el tope (270, 60 y 150); se pueden bajar, y por encima del tope el
# motor no arranca. Tampoco si presupuesto + barrera + 15 > 300.
# Presupuesto de una llamada A2A (570 en local; en Vercel 270).
PROXY_PRESUPUESTO_LLAMADA_S=270
# Espera del porqué (si vence, sigue el pedido literal).
PROXY_ESPERA_CONTEXTO_S=60
# Espera de la decisión sobre una oportunidad (si vence, no se compra nada).
PROXY_ESPERA_DECISION_S=150
# Cada cuánto mira la base la instancia que retiene una espera.
GATEWAY_SONDEO_S=1
# Cuánto se espera, antes de responder, lo que se escribió (10 por defecto).
GATEWAY_BARRERA_S=
# Gracia después de `vence` antes de cerrar del lado seguro una espera cuya
# instancia murió.
GATEWAY_GRACIA_ESPERA_S=30
# Vida de una compra (24 h).
GATEWAY_COMPRA_TTL_S=86400
# Topes de cuerpo (Vercel corta en 4,5 MB; el motor los deja en 4 MB o menos:
# más no arranca). También la respuesta del comercio.
GATEWAY_MAX_CUERPO_BYTES=1048576
GATEWAY_MAX_CUERPO_A2A_BYTES=4000000
PROXY_MAX_RESPUESTA_BYTES=

# Filtro: con el modelo hace falta un cliente de decisiones (abajo). Sin
# cliente y sin FILTRO_SOLO_HEURISTICAS=1, el filtro bloquea todo (falla
# cerrado).
FILTRO_SOLO_HEURISTICAS=
FILTRO_TIMEOUT_S=

# Capa de intención (pregunta del porqué y oportunidades). Sin credenciales
# del LLM queda apagada y las compras siguen el pedido literal.
INTENCION_ACTIVA=1
# decisiones | gemini (sin la variable: decisiones si hay cliente).
INTENCION_PROVEEDOR=
INTENCION_MODELO=
# Gemini (detector de oportunidades y agente gemini).
GOOGLE_API_KEY=
# GEMINI_API_KEY=   (el mismo dato con el otro nombre)
# Juicios tipados (filtro e intake): openai | jev.
DECISIONES_PROVEEDOR=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
DECISIONES_MODELO_OPENAI=
DECISIONES_MODELO_JEV=

# Ficha del fabricante por GTIN: fixture (fixtures/fabricante/, rotulado como
# datos de prueba), icecat o ninguna.
FABRICANTE_FUENTE=fixture
# Con icecat: en Vercel solo se puede escribir en /tmp (la caché).
ICECAT_USUARIO=
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=
ICECAT_CACHE_DIR=/tmp/icecat

# Historial (panel del cliente): días que se guardan las tablas gw_* (90 por
# defecto; en Vercel, hasta 365) y el secreto de la purga diaria (el cron de
# vercel.json llama a /interno/purgar). Vercel manda CRON_SECRET en el
# Authorization de cada cron (16 caracteres o más). Sin secreto la ruta no
# existe y no se borra nada. GATEWAY_PURGA_SECRETO es el mismo dato con otro
# nombre (si están las dos, iguales).
GATEWAY_RETENCION_DIAS=90
CRON_SECRET=

# Secretos de webhook: uno por integrador con webhook, con el nombre que dice
# su `secreto_env` (generar_secretos.py --webhook-url → WEBHOOK_SECRETO_<ID>.txt).
WEBHOOK_SECRETO_DEMO=

# ---------------------------------------------------------------------------
# PROHIBIDAS en Vercel: si alguna está prendida, el motor no arranca.
# No las cargues (ni en 0: mejor que no existan).
# ---------------------------------------------------------------------------
# PROHIBIDA: PROXY_ALLOW_STUB=1            (Guard de prueba en vez del real)
# PROHIBIDA: PROXY_PERMITIR_SIN_FILTRO=1   (gateway sin filtro)
# PROHIBIDA: PROXY_FICHA_DEMO=1            (fichas de la demo en vez de la del integrador)
# PROHIBIDA: CATALOGO_RESPALDO_FIXTURE=1   (catálogo viejo de fixtures/)
# PROHIBIDA: GATEWAY_WEBHOOKS_INSEGUROS=1  (webhooks por http e IPs privadas)

# ---------------------------------------------------------------------------
# No se usan en Vercel (no hay disco ni puertos propios: las ignora o las fija
# proxy/vercel.py). No hace falta cargarlas.
# ---------------------------------------------------------------------------
# GATEWAY_CLAVES_ARCHIVO, GATEWAY_COMERCIOS_ARCHIVO (van como *_JSON)
# GUARD_KEY_PATH, GUARD_API_TOKEN_PATH, GUARD_EVENTS_JSONL, GUARD_EVENTS_JSONL_PRIVADO
# PROXY_PORT, PROXY_HOST, PROXY_PUBLIC_URL, PROXY_ALLOW_REMOTE, GATEWAY_PORT, GATEWAY_HOST
# MERCHANT_UPSTREAM_URL, CATALOGO_URL (con GATEWAY_COMERCIOS_JSON se ignoran)
# GUARD_ACTIVO (siempre prendido), DEMO_HOY (solo grabaciones de la demo)
# GATEWAY_INSTANCIAS (siempre varias), GATEWAY_WEBHOOKS_PERFIL (siempre en_linea)
